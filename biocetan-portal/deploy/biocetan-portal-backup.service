[Unit]
Description=BIOCETAN portal database backup

[Service]
Type=oneshot
User=biocetan
Group=biocetan
WorkingDirectory=/opt/biocetan-portal
EnvironmentFile=/etc/biocetan-portal.env
ExecStart=/usr/bin/node scripts/backup.mjs --dir /var/lib/biocetan-portal/backups --keep 30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/biocetan-portal
