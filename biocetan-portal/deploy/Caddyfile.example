# Block added to the shared Caddyfile on driverschat-vm (/home/Caddy/Caddyfile). Caddy gets and
# renews the HTTPS certificate by itself; the DNS record portal.biocetan.ro → 81.181.102.218 must
# stay "DNS only" in Cloudflare (proxied, X-Forwarded-For would carry Cloudflare's IP instead of
# the visitor's; then switch TRUSTED_PROXY to cloudflare). Security headers come from the app.
portal.biocetan.ro {
	encode zstd gzip
	reverse_proxy biocetan_portal:4322
}
