# Copy to .env for local development. On the VM these go in /etc/biocetan-portal.env
# (chmod 600, owned by root), loaded by the systemd unit. Never commit real values.

# SQLite database file (created on first `npm run db:migrate`)
DATABASE_URL=file:./data/portal.db
# Public address of the portal, used in the links of invitation/reset emails
PORTAL_URL=http://localhost:4322
MAIL_FROM=BIOCETAN Portal <no-reply@biocetan.ro>
# Locally scripts/mock-resend.mjs listens here and prints mails; on the VM: https://api.resend.com
RESEND_API_URL=http://127.0.0.1:8899
# Locally any value works with the mock; on the VM a Resend key with "Sending access"
RESEND_API_KEY=re_local_mock
# 32 random bytes, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Only used once someone turns on 2FA, but set it from the start: changing it later
# invalidates every enrolled authenticator.
TOTP_ENC_KEY=
# true = admins must use an authenticator app code at login
REQUIRE_ADMIN_MFA=false
# Where the visitor's IP comes from: none (direct), x-forwarded-for (Caddy/nginx on the VM),
# cloudflare (portal behind Cloudflare proxy or Cloudflare Tunnel)
TRUSTED_PROXY=none
