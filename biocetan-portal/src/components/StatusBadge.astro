---
interface Props {
  status: 'invited' | 'active' | 'disabled' | 'inactive';
}
const { status } = Astro.props;
const { t } = Astro.locals;
const styles = {
  active: 'bg-mint-100 text-green-700',
  invited: 'bg-mint-50 text-navy-900 ring-1 ring-line',
  disabled: 'bg-white text-muted ring-1 ring-line',
  inactive: 'bg-white text-muted ring-1 ring-line',
} as const;
---

<span
  class:list={['inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold', styles[status]]}
>
  {t(`status.${status}`)}
</span>
