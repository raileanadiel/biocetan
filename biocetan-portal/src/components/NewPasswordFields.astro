---
import Field from './Field.astro';

interface Props {
  email: string;
  error?: string | undefined;
}
const { email, error } = Astro.props;
const { t } = Astro.locals;
const confirmError = error === 'passwordMismatch' ? error : undefined;
const passwordError = error && error !== 'passwordMismatch' ? error : undefined;
---

<!-- Lets password managers save the new password under the right account. -->
<input type="text" name="username" value={email} autocomplete="username" hidden readonly />
<Field
  label={t('password.new')}
  name="password"
  type="password"
  autocomplete="new-password"
  minlength={12}
  maxlength={128}
  hint={t('password.hint')}
  error={passwordError}
  autofocus
/>
<Field
  label={t('password.confirm')}
  name="confirm"
  type="password"
  autocomplete="new-password"
  error={confirmError}
/>
