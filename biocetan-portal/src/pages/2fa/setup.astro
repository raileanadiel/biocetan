---
import { renderSVG } from 'uqr';
import AuthLayout from '../../layouts/AuthLayout.astro';
import Alert from '../../components/Alert.astro';
import Button from '../../components/Button.astro';
import Field from '../../components/Field.astro';
import { beginTotpSetup, confirmTotpSetup } from '../../server/auth/mfa';
import { errorCode, field, homeFor, readForm, upgradeSession } from '../../server/web';

const { auth, deps, t } = Astro.locals;
const { user, session } = auth!;
if (user.totpEnabledAt) return Astro.redirect('/2fa');

let error: string | null = null;
let recoveryCodes: string[] | null = null;

const form = await readForm(Astro.request);
if (form) {
  try {
    recoveryCodes = await confirmTotpSetup(deps, user, field(form, 'code'));
    await upgradeSession(deps, Astro.cookies, session.id, user);
  } catch (e) {
    error = errorCode(e);
  }
}

const setup = recoveryCodes ? null : await beginTotpSetup(deps, user);
// The QR code is generated here, on the server: the secret never goes to a third-party service.
const qrSvg = setup ? renderSVG(setup.uri, { border: 2, ecc: 'M' }) : '';
const groupedSecret = setup?.secret.match(/.{1,4}/g)?.join(' ') ?? '';
---

{recoveryCodes ? (
  <AuthLayout title={t('mfa.recoveryTitle')} showLanguage={false}>
    <p class="mb-5 text-sm text-muted">{t('mfa.recoveryLead')}</p>
    <ol class="mb-6 grid grid-cols-2 gap-2 rounded-md bg-mint-50 p-4 font-mono text-sm">
      {recoveryCodes.map((code) => (
        <li>{code}</li>
      ))}
    </ol>
    <Button href={homeFor(user.role)} class="w-full">
      {t('mfa.recoveryDone')}
    </Button>
  </AuthLayout>
) : (
  <AuthLayout title={t('mfa.setupTitle')} showLanguage={false}>
    <p class="mb-5 text-sm text-muted">{t('mfa.setupLead')}</p>
    {error && (
      <div class="mb-5">
        <Alert variant="error">
          {t(error === 'throttled' ? 'errors.throttled' : 'errors.invalidCode')}
        </Alert>
      </div>
    )}
    <ol class="mb-6 list-decimal space-y-4 pl-5 text-sm">
      <li>{t('mfa.step1')}</li>
      <li>
        {t('mfa.step2')}
        <div
          class="mt-3 w-48 rounded-md border border-line bg-white p-2"
          role="img"
          aria-label={t('mfa.qrAlt')}
          set:html={qrSvg}
        />
        <p class="mt-3 text-muted">{t('mfa.manualKey')}:</p>
        <p class="font-mono text-sm break-all text-navy-900">{groupedSecret}</p>
      </li>
      <li>{t('mfa.step3')}</li>
    </ol>
    <form method="post" class="space-y-4" novalidate>
      <Field
        label={t('mfa.code')}
        name="code"
        autocomplete="one-time-code"
        inputmode="numeric"
        maxlength={7}
      />
      <Button class="w-full">{t('mfa.confirm')}</Button>
    </form>
    <form method="post" action="/logout" class="mt-5 text-sm">
      <button type="submit" class="link">
        {t('common.logout')}
      </button>
    </form>
  </AuthLayout>
)}
