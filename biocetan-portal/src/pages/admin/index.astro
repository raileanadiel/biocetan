---
import AppLayout from '../../layouts/AppLayout.astro';
import ActivityTable from '../../components/ActivityTable.astro';
import { activity, dashboardStats } from '../../server/accounts';
import type { TranslationKey } from '../../i18n';

const { auth, deps, t } = Astro.locals;
const viewer = auth!.viewer;
const [stats, recent] = await Promise.all([
  dashboardStats(deps, viewer),
  activity(deps, viewer, { limit: 20 }),
]);
const tiles: { label: TranslationKey; value: number; href: string }[] = [
  { label: 'admin.statClients', value: stats.companies, href: '/admin/companies' },
  { label: 'admin.statActiveUsers', value: stats.activeClients, href: '/admin/companies' },
  { label: 'admin.statPendingInvites', value: stats.pendingInvites, href: '/admin/companies' },
];
---

<AppLayout title={t('admin.dashboardTitle')}>
  <h1 class="text-h2 font-bold">{t('admin.dashboardTitle')}</h1>
  <div class="mt-6 grid gap-4 sm:grid-cols-3">
    {tiles.map((tile) => (
      <a href={tile.href} class="card block transition-colors hover:border-navy-900">
        <p class="text-sm text-muted">{t(tile.label)}</p>
        <p class="mt-1 font-heading text-3xl font-bold text-navy-900">{tile.value}</p>
      </a>
    ))}
  </div>
  <section class="card mt-8">
    <h2 class="mb-4 text-h3 font-bold">{t('admin.recentActivity')}</h2>
    <ActivityTable entries={recent} />
  </section>
</AppLayout>
