{
  "name": "biocetan-portal",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env scripts/migrate.mjs && node --env-file-if-exists=.env dist/server/entry.mjs",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "mock:resend": "node scripts/mock-resend.mjs",
    "admin:invite": "node --env-file-if-exists=.env scripts/invite-admin.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "drizzle-orm": "^0.45.4",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "vitest": "~4.1.11"
  }
}
