{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "biocetan-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "biocetan-web",
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "biocetan-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "biocetan-portal",
        "run",
        "dev"
      ],
      "port": 4322
    },
    {
      "name": "portal-mock-mail",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "biocetan-portal/scripts/mock-resend.mjs"
      ],
      "port": 8899
    },
    {
      "name": "biocetan-portal-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "biocetan-portal",
        "run",
        "preview"
      ],
      "port": 4321
    }
  ]
}
