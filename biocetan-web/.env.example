# Copy to .env for local overrides. Never commit .env.

# Canonical origin used for canonical/hreflang/sitemap URLs. Defaults to https://www.biocetan.ro
# SITE_URL=https://www.biocetan.ro

# Set to "true" ONLY on the production deployment. Anything else emits noindex + robots Disallow.
PUBLIC_ALLOW_INDEXING=false

# Cloudflare Turnstile SITE key (public, baked into the page at build time).
# Cloudflare's public TEST key below always passes; use your real site key in production.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
