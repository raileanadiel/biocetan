---
import Icon from '../ui/Icon.astro';

/** Native <details> accordion (no JS, keyboard-accessible) + FAQPage structured data. */
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<div class="divide-y divide-line rounded-lg border border-line bg-white">
  {items.map((item) => (
    <details class="group">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-left font-semibold text-navy-900 hover:bg-mint-50 [&::-webkit-details-marker]:hidden">
        {item.q}
        <Icon
          name="chevron-down"
          class="size-5 text-green-700 transition-transform group-open:rotate-180"
        />
      </summary>
      <p class="px-5 pb-5 text-muted">{item.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>
