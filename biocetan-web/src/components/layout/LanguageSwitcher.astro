---
import { locales, localeMeta, type Locale } from '../../i18n/config';
import { pathFor, type PageId } from '../../i18n/routes';
import { useTranslations } from '../../i18n';

/** Links to the same page in every locale. With 2–3 languages a link group beats a dropdown. */
interface Props {
  locale: Locale;
  pageId?: PageId;
  class?: string;
}

const { locale, pageId = 'home', class: className } = Astro.props;
const t = useTranslations(locale);
---

<ul
  class:list={['items-center gap-1 text-sm font-semibold', className ?? 'flex']}
  aria-label={t('a11y.language')}
>
  {locales.map((l) => (
    <li>
      <a
        href={pathFor(pageId, l)}
        hreflang={localeMeta[l].hreflang}
        lang={localeMeta[l].hreflang}
        title={localeMeta[l].name}
        aria-current={l === locale ? 'true' : undefined}
        class:list={[
          'inline-flex min-h-11 min-w-11 items-center justify-center rounded-md px-2 transition-colors',
          l === locale ? 'bg-mint-100 text-navy-900' : 'text-muted hover:text-navy-900',
        ]}
      >
        {localeMeta[l].label}
      </a>
    </li>
  ))}
</ul>
