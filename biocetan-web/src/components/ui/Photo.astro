---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Content photo: AVIF/WebP at several widths, rounded frame, optional caption.
 * `frame` fixes the aspect ratio (e.g. 'aspect-[4/3]') and crops with object-cover; `focus`
 * moves the crop (e.g. 'object-[50%_70%]'). Both are passed as literal Tailwind classes so
 * Tailwind can see them. `zoom` wraps the photo in a link to its full-size version.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  frame?: string;
  focus?: string;
  sizes?: string;
  zoom?: boolean;
  zoomLabel?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  frame,
  focus = 'object-center',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  zoom = false,
  zoomLabel,
  class: className,
} = Astro.props;

const widths = [480, 800, 1200].filter((w) => w < src.width).concat(src.width);
const full = zoom ? await getImage({ src, format: 'webp', width: src.width }) : null;
const imgClass = frame ? `size-full object-cover ${focus}` : 'h-auto w-full';
---

<figure class={className}>
  {full ? (
    <a
      href={full.src}
      target="_blank"
      rel="noopener"
      aria-label={zoomLabel ? `${caption ?? alt} (${zoomLabel})` : undefined}
      class:list={[
        'group block overflow-hidden rounded-lg bg-mint-100 focus-visible:outline-offset-4',
        frame,
      ]}
    >
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        class:list={[imgClass, 'transition-transform duration-300 group-hover:scale-[1.03]']}
      />
    </a>
  ) : (
    <div class:list={['overflow-hidden rounded-lg bg-mint-100', frame]}>
      <Picture
        src={src}
        alt={alt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        class={imgClass}
      />
    </div>
  )}
  {caption && <figcaption class="mt-2 text-sm text-muted">{caption}</figcaption>}
</figure>
