---
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import MapEmbed from '../components/ui/MapEmbed.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { site } from '../config/site';
import { routes, formatDuration } from '../config/logistics';
import { useTranslations } from '../i18n';
import { pathFor, type PageId } from '../i18n/routes';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  pageId: PageId;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const contactHref = pathFor('contact', locale);
const visitHref = `${contactHref}?product=visit`;
const logisticsHref = `${contactHref}?product=logistics`;

const stats = (['a', 'b', 'c', 'd'] as const).map((k) => ({
  value: t(`facility.stat.${k}.value`),
  label: t(`facility.stat.${k}.label`),
}));

const linePoints = (['a', 'b', 'c', 'd'] as const).map((k) => t(`facility.lines.point.${k}`));
const storagePoints = (['a', 'b', 'c', 'd'] as const).map((k) => t(`facility.storage.point.${k}`));
const packagingPoints = (['a', 'b', 'c', 'd', 'e'] as const).map((k) =>
  t(`facility.packaging.point.${k}`),
);
---

<PageHero
  locale={locale}
  pageId="facility"
  title={t('pages.facility.title')}
  accent={t('pages.facility.accent')}
  lead={t('pages.facility.lead')}
>
  <Fragment slot="actions">
    <Button href={visitHref} size="lg" icon="calendar">
      {t('facility.visit.cta')}
    </Button>
    <Button href={logisticsHref} size="lg" variant="outline-light">
      {t('cta.quote')}
    </Button>
  </Fragment>
</PageHero>

<Section compact class="border-b border-line">
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {stats.map((s) => (
      <li>
        <p class="font-heading text-2xl font-extrabold text-navy-900">{s.value}</p>
        <p class="text-sm text-muted">{s.label}</p>
      </li>
    ))}
  </ul>
</Section>

<Section>
  <SectionHeading title={t('facility.lines.title')} lead={t('facility.lines.text')} />
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {linePoints.map((point) => (
      <li class="flex items-start gap-3 rounded-lg border border-line bg-white p-4">
        <Icon
          name="check"
          class="mt-0.5 size-5 shrink-0 rounded-full bg-green-600 p-1 text-white"
        />
        <span>{point}</span>
      </li>
    ))}
  </ul>
</Section>

<Section tone="mint">
  <SectionHeading title={t('facility.storage.title')} lead={t('facility.storage.text')} />
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {storagePoints.map((point) => (
      <li class="flex items-start gap-3 rounded-lg border border-line bg-white p-4">
        <Icon
          name="check"
          class="mt-0.5 size-5 shrink-0 rounded-full bg-green-600 p-1 text-white"
        />
        <span>{point}</span>
      </li>
    ))}
  </ul>
</Section>

<Section id="location">
  <SectionHeading
    title={t('facility.location.title')}
    eyebrow={t('facility.location.lead')}
    lead={t('facility.location.text')}
  />
  <div class="mt-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
    <MapEmbed locale={locale} />
    <div class="overflow-x-auto rounded-lg border border-line">
      <table class="w-full min-w-[420px] border-collapse text-left">
        <caption class="sr-only">{t('distances.title')}</caption>
        <thead>
          <tr class="bg-mint-50 text-sm text-navy-900">
            <th scope="col" class="p-3 font-bold">
              {t('distances.colDestination')}
            </th>
            <th scope="col" class="p-3 font-bold">
              {t('distances.colDistance')}
            </th>
            <th scope="col" class="p-3 font-bold">
              {t('distances.colTime')}
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line text-sm">
          {routes.map((r) => (
            <tr>
              <th scope="row" class="p-3 font-semibold text-navy-900">
                {t(`distances.${r.key}`)}
              </th>
              <td class="p-3 text-muted">{r.km} km</td>
              <td class="p-3 text-muted">{formatDuration(r.minutes)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="border-t border-line bg-white p-4 text-sm text-muted">{t('distances.lead')}</p>
    </div>
  </div>
</Section>

<Section tone="navy">
  <SectionHeading title={t('facility.packaging.title')} />
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {packagingPoints.map((point) => (
      <li class="flex items-start gap-3">
        <Icon name="truck" class="mt-0.5 size-5 shrink-0 text-green-300" />
        <span class="text-white/90">{point}</span>
      </li>
    ))}
  </ul>
</Section>

<Section tone="forest">
  <div class="grid items-center gap-8 lg:grid-cols-[1.3fr_0.7fr]">
    <div>
      <h2 class="font-heading text-h3 font-bold">{t('facility.visit.title')}</h2>
      <p class="mt-3 max-w-2xl text-white/85">{t('facility.visit.text')}</p>
      <p class="mt-4 flex items-center gap-2 text-white/80">
        <Icon name="map-pin" class="size-5 text-green-300" />
        {site.address.street}, {site.address.city}, {site.address.county}
      </p>
    </div>
    <p class="lg:text-right">
      <Button href={visitHref} size="lg" variant="outline-light" icon="calendar">
        {t('facility.visit.cta')}
      </Button>
    </p>
  </div>
</Section>

<CtaBand locale={locale} title={t('facility.closing.title')} text={t('facility.closing.text')} />
