---
import PageHero from '../components/ui/PageHero.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { useTranslations } from '../i18n';
import { pathFor, type PageId } from '../i18n/routes';
import type { Locale } from '../i18n/config';

/** Placeholder for pages whose real view (src/views/<Id>.astro) is not built yet. */
interface Props {
  locale: Locale;
  pageId: PageId;
}

const { locale, pageId } = Astro.props;
const t = useTranslations(locale);
const showNotice = import.meta.env.PUBLIC_ALLOW_INDEXING !== 'true';
const isLegal = pageId === 'privacy' || pageId === 'terms' || pageId === 'cookies';
---

<PageHero
  locale={locale}
  pageId={pageId}
  title={t(`pages.${pageId}.title`)}
  accent={t(`pages.${pageId}.accent`)}
  lead={t(`pages.${pageId}.lead`)}
>
  <Fragment slot="actions">
    {pageId !== 'contact' && (
      <Button href={pathFor('contact', locale)} size="lg">
        {t('cta.quote')}
      </Button>
    )}
  </Fragment>
</PageHero>

{showNotice && (
  <Section tone="mint" compact>
    <p class="text-sm text-muted">{t('stub.notice')}</p>
  </Section>
)}

{!isLegal && pageId !== 'contact' && <CtaBand locale={locale} />}
