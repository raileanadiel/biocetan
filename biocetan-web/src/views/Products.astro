---
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import SubNav from '../components/ui/SubNav.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { useTranslations } from '../i18n';
import { pathFor, type PageId } from '../i18n/routes';
import type { Locale } from '../i18n/config';
import type { ProductValue } from '../lib/contact/constants';

interface Props {
  locale: Locale;
  pageId: PageId;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const quoteHref = (product: ProductValue) => `${pathFor('contact', locale)}?product=${product}`;

const products = ['rme', 'sfme', 'sme'] as const;

const subnavItems = (['rme', 'sfme', 'sme', 'custom'] as const).map((id) => ({
  id,
  label: t(`products.nav.${id}`),
}));

const customFeedstocks = ['a', 'b', 'c', 'd', 'e', 'f'] as const;
---

<PageHero
  locale={locale}
  pageId="products"
  title={t('pages.products.title')}
  accent={t('pages.products.accent')}
  lead={t('pages.products.lead')}
>
  <Fragment slot="actions">
    <Button href={pathFor('contact', locale)} size="lg">
      {t('cta.quote')}
    </Button>
  </Fragment>
</PageHero>

<SubNav items={subnavItems} />

<Section>
  <SectionHeading title={t('products.intro.title')} lead={t('products.intro.lead')} />

  <div class="mt-10 overflow-x-auto rounded-lg border border-line">
    <table class="w-full min-w-[640px] border-collapse text-left">
      <caption class="sr-only">{t('products.compare.title')}</caption>
      <thead>
        <tr class="bg-mint-50 text-sm text-navy-900">
          <th scope="col" class="p-4 font-bold">
            {t('products.compare.colProduct')}
          </th>
          <th scope="col" class="p-4 font-bold">
            {t('products.compare.colFeedstock')}
          </th>
          <th scope="col" class="p-4 font-bold">
            {t('products.compare.colBestFor')}
          </th>
          <th scope="col" class="p-4 font-bold">
            {t('products.compare.colPackaging')}
          </th>
          <th scope="col" class="p-4 font-bold">
            <span class="sr-only">{t('products.compare.action')}</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line text-sm">
        {products.map((p) => (
          <tr>
            <th scope="row" class="p-4 font-heading text-lg font-extrabold text-green-700">
              {t(`products.nav.${p}` as const)}
            </th>
            <td class="p-4 text-ink">{t(`products.${p}.title` as const)}</td>
            <td class="p-4 text-muted">{t(`products.${p}.bestFor` as const)}</td>
            <td class="p-4 text-muted">{t('products.compare.packagingValue')}</td>
            <td class="p-4">
              <Button href={quoteHref(p)} size="md" variant="outline" icon="arrow-right">
                {t('products.compare.action')}
              </Button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Section>

{products.map((p, index) => (
  <Section id={p} tone={index % 2 === 0 ? 'mint' : 'white'}>
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="text-sm font-bold tracking-[0.14em] text-green-700 uppercase">
          {t(`products.${p}.eyebrow` as const)}
        </p>
        <h2 class="mt-2 font-heading text-h2 font-extrabold tracking-tight text-navy-900 uppercase">
          {t(`products.${p}.title` as const)}
        </h2>
        <p class="mt-3 text-lead text-muted">{t(`products.${p}.lead` as const)}</p>
        <p class="mt-5 max-w-2xl">{t(`products.${p}.overview` as const)}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={quoteHref(p)}>{t('products.compare.action')}</Button>
          <Button
            href={`${pathFor('contact', locale)}?product=documentation`}
            variant="outline"
            icon="file-text"
          >
            {t('products.specNote.cta')}
          </Button>
        </div>
      </div>
      <ul class="grid content-start gap-3 self-start rounded-lg border border-line bg-white p-6">
        {(['a', 'b', 'c', 'd', 'e'] as const).map((letter) => (
          <li class="flex items-start gap-3">
            <Icon
              name="check"
              class="mt-0.5 size-5 shrink-0 rounded-full bg-green-600 p-1 text-white"
            />
            <span>{t(`products.${p}.feature.${letter}` as const)}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>
))}

<Section id="custom">
  <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="text-sm font-bold tracking-[0.14em] text-green-700 uppercase">
        {t('products.custom.eyebrow')}
      </p>
      <h2 class="mt-2 font-heading text-h2 font-extrabold tracking-tight text-navy-900 uppercase">
        {t('products.custom.title')}
      </h2>
      <p class="mt-3 text-lead text-muted">{t('products.custom.lead')}</p>
      <p class="mt-5 max-w-2xl">{t('products.custom.overview')}</p>
      <p class="mt-8">
        <Button href={quoteHref('custom-ester')}>{t('products.custom.cta')}</Button>
      </p>
    </div>
    <div class="rounded-lg border border-line bg-mint-50 p-6">
      <h3 class="font-heading text-lg font-bold text-navy-900">
        {t('products.custom.feedstockTitle')}
      </h3>
      <ul class="mt-4 grid gap-3">
        {customFeedstocks.map((letter) => (
          <li class="flex items-start gap-3">
            <Icon name="leaf" class="mt-0.5 size-5 shrink-0 text-green-700" />
            <span>{t(`products.custom.feedstock.${letter}` as const)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<Section tone="navy">
  <div class="grid items-center gap-8 lg:grid-cols-[1.3fr_0.7fr]">
    <div>
      <h2 class="font-heading text-h3 font-bold">{t('products.specNote.title')}</h2>
      <p class="mt-3 max-w-2xl text-white/85">{t('products.specNote.text')}</p>
    </div>
    <p class="lg:text-right">
      <Button
        href={`${pathFor('contact', locale)}?product=documentation`}
        variant="outline-light"
        icon="file-text"
      >
        {t('products.specNote.cta')}
      </Button>
    </p>
  </div>
</Section>

<CtaBand locale={locale} title={t('products.closing.title')} text={t('products.closing.text')} />
